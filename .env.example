# ===========================================================================
# GitSync Studio - environment template
# ===========================================================================
# Copy to `.env` and adjust. `.env` is git-ignored and MUST stay that way.
#
#   cp .env.example .env
#
# The values below are the *host* view (what you use when running a service
# directly on your machine, or connecting with psql). docker compose overrides
# DATABASE_URL / REDIS_URL / CELERY_* for the api and worker containers so they
# use the in-network hostnames `postgres` and `redis` instead of localhost.
# ===========================================================================

# --- Application ----------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=gitsync-studio-api
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # console (dev) | json (prod/CI)

# Signs application sessions. Generate a real one before any deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Host port mapping ----------------------------------------------------
# 3000 and 5432 are commonly taken by other local projects, so the defaults
# below deliberately avoid them.
WEB_HOST_PORT=3100
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=gitsync
POSTGRES_PASSWORD=gitsync_dev_password
POSTGRES_DB=gitsync
DATABASE_URL=postgresql+asyncpg://gitsync:gitsync_dev_password@localhost:5433/gitsync

# --- Redis / Celery -------------------------------------------------------
# db 0 = application cache, db 1 = Celery broker, db 2 = Celery results.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# --- Web <-> API ----------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the browser bundle: never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://api:8000
CORS_ALLOW_ORIGINS=http://localhost:3100,http://localhost:3000

# ===========================================================================
# The rest is declared now so the contract is visible, but stays EMPTY until
# the phase that needs it. An empty value means "feature disabled".
# ===========================================================================

# --- PHASE 2: GitHub App --------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the downloaded .pem, NOT the key contents. Keep the file out of git.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# --- PHASE 4: Google OAuth + Drive ---------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Least privilege: drive.file only sees files this app created.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Fernet key used to encrypt stored refresh tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- PHASE 3: model registry ---------------------------------------------
MODEL_REGISTRY_DIR=ml/models
ACTIVE_MERGE_MODEL_VERSION=
ACTIVE_TIMING_MODEL_VERSION=

# --- PHASE 5: optional grounded LLM README mode --------------------------
# Deterministic templates must work first. Leave blank to keep LLM mode off.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
